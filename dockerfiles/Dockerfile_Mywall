FROM php:8.2-apache

# Establecer entorno de producción
ENV APP_ENV=prod
ENV APP_DEBUG=0
ENV COMPOSER_ALLOW_SUPERUSER=1

# Instalar dependencias del sistema y extensiones PHP
RUN apt-get update && apt-get install -y \
    libicu-dev \
    libpq-dev \
    zip \
    unzip \
    git \
    curl \
    && docker-php-ext-install intl pdo pdo_mysql opcache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configurar Apache
RUN a2enmod rewrite ssl && \
    echo '<VirtualHost *:80> \n\
    DocumentRoot /var/www/html/public \n\
    DirectoryIndex index.php \n\
    \n\
    <Directory /var/www/html/public> \n\
        AllowOverride None \n\
        Order Allow,Deny \n\
        Allow from All \n\
        \n\
        FallbackResource /index.php \n\
    </Directory> \n\
    \n\
    <Directory /var/www/html/public/bundles> \n\
        DirectoryIndex disabled \n\
        FallbackResource disabled \n\
    </Directory> \n\
    \n\
    ErrorLog /var/log/apache2/project_error.log \n\
    CustomLog /var/log/apache2/project_access.log combined \n\
</VirtualHost>' > /etc/apache2/sites-available/000-default.conf && \
    echo '<VirtualHost *:443> \n\
    DocumentRoot /var/www/html/public \n\
    DirectoryIndex index.php \n\
    \n\
    SSLEngine on \n\
    SSLCertificateFile /etc/ssl/certs/mywall-eks.work.gd.crt \n\
    SSLCertificateKeyFile /etc/ssl/private/mywall-eks.work.gd.key \n\
    SSLCertificateChainFile /etc/ssl/certs/mywall-eks.work.gd.ca-bundle \n\
    \n\
    <Directory /var/www/html/public> \n\
        AllowOverride None \n\
        Order Allow,Deny \n\
        Allow from All \n\
        \n\
        FallbackResource /index.php \n\
    </Directory> \n\
    \n\
    <Directory /var/www/html/public/bundles> \n\
        DirectoryIndex disabled \n\
        FallbackResource disabled \n\
    </Directory> \n\
    \n\
    ErrorLog /var/log/apache2/project_error.log \n\
    CustomLog /var/log/apache2/project_access.log combined \n\
</VirtualHost>' > /etc/apache2/sites-available/default-ssl.conf

# Habilitar sitio SSL
RUN a2ensite default-ssl.conf && \
    service apache2 reload

# Configurar directorio de trabajo
WORKDIR /var/www/html

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Crear directorios necesarios y establecer permisos
RUN mkdir -p var/cache var/log public/build \
    && chmod -R 755 public \
    && chmod -R 755 var/cache var/log public/build

# Copiar archivos de configuración
COPY composer.* ./ 
COPY importmap.php ./

# Instalar dependencias de Composer
RUN composer install \
    --prefer-dist \
    --no-dev \
    --no-scripts \
    --no-progress \
    --no-interaction

# Copiar el resto de la aplicación
COPY . .

# Optimizar y configurar permisos finales
RUN set -e; \
    composer dump-autoload --optimize; \
    php bin/console cache:clear --env=prod --no-debug; \
    php bin/console importmap:install; \
    php bin/console assets:install; \
    chown -R www-data:www-data .; \
    chmod -R 755 public; \
    chmod -R 777 var

# Exponer puertos HTTP y HTTPS
EXPOSE 80 443

# Comando por defecto
CMD ["apache2-foreground"]
